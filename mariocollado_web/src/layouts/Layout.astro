---
// Supports weights 100-900
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/ibm-plex-mono/400.css";

import "/src/styles/global.css";
import Preloader from "@/components/ui/Preloader.astro";
import LanguageSelector from "@/components/LanguageSelector.astro";

const title = "mariocollado";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <title>{title}</title>


    <script>
      document.addEventListener("DOMContentLoaded", () => {
        setTimeout(() => {
          [
            "press-start-2p",
            "alfa-slab-one",
            "poiret-one",
            "monoton",
            "abril-fatface",
          ].forEach((font) => {
            const link = document.createElement("link");
            link.rel = "preload";
            link.href = `/node_modules/@fontsource/${font}/files/${font}-latin-400-normal.woff2`;
            link.as = "font";
            link.type = "font/woff2";
            link.crossOrigin = "anonymous";
            document.head.appendChild(link);
          });
        }, 200);
      });
    </script>
  </head>
  <body class="bg-paper text-ink dark:bg-night dark:text-paper">
    <Preloader />
    <LanguageSelector />
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
