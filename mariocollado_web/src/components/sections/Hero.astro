---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<section class="mx-auto grid max-w-[1440px] grid-cols-4 items-end gap-x-6 gap-y-10 px-4 pb-16 pt-10 md:grid-cols-12 md:px-10 md:pt-16">
  <div class="reveal col-span-4 md:col-span-5">
    <p class="font-mono text-xs uppercase tracking-widest text-muted">{t("hero.location")}</p>
    <h1 class="mt-4 font-display text-[clamp(2.75rem,7vw,6.5rem)] font-semibold leading-[0.95] tracking-tight">
      {t("hero.title")}
    </h1>
    <p class="mt-8 max-w-md text-base leading-relaxed md:text-lg">{t("hero.text")}</p>
    <a href="#work" class="mt-10 inline-flex items-center gap-3 font-mono text-xs uppercase tracking-widest">
      <span class="h-px w-10 bg-fg" aria-hidden="true"></span>
      {t("hero.scroll")}
    </a>
  </div>
  <figure class="reveal col-span-4 md:col-span-7">
    <img
      src="/images/photography/caldoveiro_3.webp"
      alt={t("hero.image_alt")}
      fetchpriority="high"
      class="aspect-[4/5] w-full object-cover md:aspect-[4/3]"
    />
  </figure>
</section>
