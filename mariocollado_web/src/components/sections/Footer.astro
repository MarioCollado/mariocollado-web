---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
const year = String(new Date().getFullYear());
---

<footer class="mx-auto flex max-w-[1440px] justify-between border-t border-line px-4 py-8 font-mono text-xs uppercase text-muted md:px-10">
  <span>{t("footer.rights", { year })}</span>
  <span class="text-xs opacity-70">
    Iconos diseñados por <a href="https://www.flaticon.es/autores/moonde" title="Moon.de" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Moon.de</a> from <a href="https://www.flaticon.es/" title="Flaticon" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">www.flaticon.es</a>
  </span>
  <span>Asturias</span>
</footer>
