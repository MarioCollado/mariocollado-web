---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import CarouselComponent from "../../lib/carousel";
import { photos } from "../../data/photos";

const t = useTranslations(getLangFromUrl(Astro.url));

// Coloca los archivos en public/assets con estos nombres y se enganchan solos.
// Logos: public/assets/logos/<slug>.svg   Portadas: public/assets/covers/<slug>.jpg
// Vídeo de filmografía: pon aquí el ID de YouTube (lo que va después de ?v=).
const FILM_YOUTUBE_ID = "0HbEUKXJqHM";
// Enlace al canal de YouTube (pon la URL completa cuando la tengas).
const FILM_CHANNEL_URL = "https://www.youtube.com/@mcollado";
const renaissanceUrl = "https://open.spotify.com/album/7bqMbjBDH5YXqErJmON5nd";
const gymlogUrl = "https://github.com/MarioCollado/personal_daily_app_v0/tree/main/gymlog";
const liveCueFeatures = ["setlists", "osc", "remote"] as const;

const cells = [
  { logo: "work_1", title: "LIVECUE", kind: t("work.livecue.type") },
  { logo: "work_2", title: t("work.renaissance.title"), kind: t("work.renaissance.kind") },
  { logo: "work_3", title: t("work.film.title"), kind: t("work.film.type") },
  { logo: "work_4", title: "Gymlog", kind: "" },
];
---

<section id="work" class="mx-auto flex min-h-[100svh] max-w-[1440px] scroll-mt-24 flex-col justify-center border-t border-line px-4 py-12 md:px-10">
  <h2 class="mb-8 font-mono text-xs uppercase tracking-widest text-muted">{t("work.title")}</h2>

  <div class="work-grid">
    {cells.map((cell, i) => (
      <article data-cell data-open="false" class={`cell ${i % 2 === 0 ? "cell--light" : "cell--dark"}`}>
        <button type="button" class="cell__head" aria-expanded="false">
          <img src={`/assets/logos/${cell.logo}.png`} alt={cell.title} class="cell__logo" onerror="this.remove()" />
          {cell.kind && <span class="cell__kind font-mono text-xs uppercase tracking-widest">{cell.kind}</span>}
        </button>

        <div class="cell__body">
          <h3 class="cell__title">{cell.title}</h3>
          {cell.logo === "work_1" && (
            <>
              <p class="mb-4 text-base leading-relaxed">{t("work.livecue.desc")}</p>
              <ul class="mb-4 grid gap-3 text-sm">
                {liveCueFeatures.map((f) => (
                  <li>
                    <strong class="font-medium">{t(`work.livecue.features.${f}.title`)}</strong>
                    <span class="block opacity-80">{t(`work.livecue.features.${f}.desc`)}</span>
                  </li>
                ))}
              </ul>
            </>
          )}

          {cell.logo === "work_2" && (
            <>
              <img src="/assets/covers/la-renaissance.png" alt={t("work.renaissance.title")} class="cell__cover mb-4" onerror="this.remove()" />
              <p class="mb-4 text-base leading-relaxed">{t("work.renaissance.desc")}</p>
              <a href={renaissanceUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-xs uppercase tracking-widest underline underline-offset-4">{t("work.renaissance.link")}</a>
            </>
          )}

          {cell.logo === "work_3" && (
            <>
              <p class="mb-4 text-base leading-relaxed">{t("work.film.desc")}</p>
              {FILM_CHANNEL_URL && (
                <a href={FILM_CHANNEL_URL} target="_blank" rel="noopener noreferrer" class="mb-4 inline-block font-mono text-xs uppercase tracking-widest underline underline-offset-4">{t("work.film.link")}</a>
              )}
              {FILM_YOUTUBE_ID && (
                <iframe
                  class="aspect-video w-full"
                  src={`https://www.youtube-nocookie.com/embed/${FILM_YOUTUBE_ID}`}
                  title={t("work.film.title")}
                  loading="lazy"
                  allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              )}
            </>
          )}

          {cell.logo === "work_4" && (
            <>
              <p class="mb-2 text-base leading-relaxed">{t("work.gymlog.desc")}</p>
              <p class="mb-4 font-mono text-xs uppercase tracking-widest opacity-80">{t("work.gymlog.stack")}</p>
              <a href={gymlogUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-xs uppercase tracking-widest underline underline-offset-4">{t("work.livecue.link")}</a>
            </>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<section id="gallery" class="mx-auto flex min-h-[100svh] max-w-[1440px] scroll-mt-24 flex-col justify-center border-t border-line px-4 py-12 md:px-10">
  <CarouselComponent
    photos={photos}
    galleryLabel={t("gallery.title")}
    pauseLabel={t("gallery.pause")}
    playLabel={t("gallery.play")}
    emptyLabel={t("gallery.empty")}
    client:visible
  />
</section>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }
  .cell {
    display: flex;
    flex-direction: column;
    min-height: 0;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .cell[data-open="true"] {
    grid-column: span 2;
    aspect-ratio: auto;
  }
  /* Solo colores del tema: 1 y 3 claros, 2 y 4 oscuros */
  .cell--light {
    background-color: var(--bg);
    color: var(--fg);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .cell--dark {
    background-color: var(--fg);
    color: var(--bg);
  }
  .cell__head {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 1.25rem;
    text-align: left;
    color: inherit;
  }
  .cell__logo {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
  }
  @media (min-width: 768px) {
    .cell__logo {
      width: 4.5rem;
      height: 4.5rem;
    }
  }
  .cell__title {
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .cell__body {
    display: none;
    padding: 0 1.25rem 1.5rem;
  }
  .cell[data-open="true"] .cell__body {
    display: block;
  }
  .cell__cover {
    width: 9rem;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  /* Escritorio: fila de bloques inclinados que se expanden al pasar el ratón */
  @media (min-width: 768px) {
    .work-grid {
      display: flex;
      height: 70svh;
      min-height: 420px;
      gap: 0;
    }
    .cell {
      flex: 1 1 0;
      aspect-ratio: auto;
      margin-left: -24px;
      clip-path: polygon(24px 0, 100% 0, calc(100% - 24px) 100%, 0 100%);
      transition: flex-grow 700ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .cell:first-child {
      margin-left: 0;
      clip-path: polygon(0 0, 100% 0, calc(100% - 24px) 100%, 0 100%);
    }
    .cell:last-child {
      clip-path: polygon(24px 0, 100% 0, 100% 100%, 0 100%);
    }
    .cell[data-open="true"] {
      flex-grow: 3;
      grid-column: auto;
    }
    .cell__head {
      padding: 2rem;
    }
    .cell__body {
      padding: 0 2rem 2rem;
      max-width: 28rem;
    }
  }
</style>

<script>
  const cells = Array.from(document.querySelectorAll<HTMLElement>("[data-cell]"));
  const desktop = window.matchMedia("(min-width: 768px) and (hover: hover)");

  const setOpen = (cell: HTMLElement, open: boolean) => {
    cell.dataset.open = String(open);
    cell.querySelector(".cell__head")?.setAttribute("aria-expanded", String(open));
  };

  // Solo un bloque abierto a la vez
  const openOnly = (target: HTMLElement) => {
    cells.forEach((c) => setOpen(c, c === target));
  };

  cells.forEach((cell) => {
    const head = cell.querySelector<HTMLButtonElement>(".cell__head");

    cell.addEventListener("pointerenter", (e) => {
      if (desktop.matches && e.pointerType === "mouse") openOnly(cell);
    });
    cell.addEventListener("pointerleave", (e) => {
      if (desktop.matches && e.pointerType === "mouse") setOpen(cell, false);
    });
    head?.addEventListener("click", () => {
      const willOpen = cell.dataset.open !== "true";
      if (willOpen) openOnly(cell);
      else setOpen(cell, false);
    });
  });
</script>
