---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import CarouselComponent from "../../lib/carousel";
import { photos } from "../../data/photos";

const t = useTranslations(getLangFromUrl(Astro.url));
const renaissanceUrl = "https://open.spotify.com/album/7bqMbjBDH5YXqErJmON5nd";
const liveCueFeatures = ["setlists", "osc", "remote"] as const;
---

<section
  id="work"
  class="mx-auto flex min-h-[100svh] max-w-[1440px] scroll-mt-24 flex-col justify-center border-t border-line px-4 py-12 md:px-10"
>
  <h2 class="mb-8 font-mono text-xs uppercase tracking-widest text-muted">
    {t("work.title")}
  </h2>

  <div class="work-carousel" data-work-carousel>
    <div class="work-carousel__toolbar">
      <p
        class="work-carousel__count font-mono"
        data-work-count
        aria-live="polite"
      >
        01 / 04
      </p>
      <div class="work-carousel__controls">
        <button
          class="work-carousel__arrow"
          type="button"
          data-work-previous
          aria-label={t("work.carousel.previous")}
          disabled
        >
          <span aria-hidden="true">←</span>
        </button>
        <button
          class="work-carousel__arrow"
          type="button"
          data-work-next
          aria-label={t("work.carousel.next")}
        >
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <div
      class="work-carousel__viewport"
      data-work-viewport
      role="region"
      aria-label={t("work.carousel.region")}
      tabindex="0"
    >
      <div class="work-carousel__track">
        <article class="work-carousel__slide livecue-project" data-work-slide>
          <div class="livecue-project__eyebrow font-mono">
            <span></span>
            <!-- <span>01 / {t("work.livecue.type")}</span> -->
            <span>PYTHON · FLET · OSC</span>
          </div>

          <div class="livecue-project__body">
            <div class="livecue-project__intro">
              <h3 class="livecue-project__title font-display">LiveCue</h3>
              <p class="livecue-project__description">
                {t("work.livecue.desc")}
              </p>
              <a
                class="livecue-project__link font-mono"
                href="https://github.com/MarioCollado/livecue"
                target="_blank"
                rel="noopener noreferrer"
              >
                {t("work.livecue.link")}
                <span aria-hidden="true">↗</span>
              </a>
            </div>

            <ol class="livecue-capabilities">
              {
                liveCueFeatures.map((feature, index) => (
                  <li class="livecue-capability">
                    <span class="livecue-capability__index font-mono">
                      0{index + 1}
                    </span>
                    <div>
                      <h4>{t(`work.livecue.features.${feature}.title`)}</h4>
                      <p>{t(`work.livecue.features.${feature}.desc`)}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </article>

        <article
          class="work-carousel__slide work-editorial-slide"
          data-work-slide
        >
          <p class="work-editorial-slide__eyebrow font-mono">
            <!-- 02 / {t("work.renaissance.kind")} -->
          </p>
          <div class="work-editorial-slide__body">
            <h3 class="work-editorial-slide__title font-display">
              {t("work.renaissance.title")}
            </h3>
            <div class="work-editorial-slide__copy">
              <p>{t("work.renaissance.desc")}</p>
              <a
                href={renaissanceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="work-editorial-slide__link font-mono"
              >
                {t("work.renaissance.link")}
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>

        <article
          class="work-carousel__slide work-editorial-slide"
          data-work-slide
        >
          <p class="work-editorial-slide__eyebrow font-mono">
            <!-- 03 / {t("work.film.type")} -->
          </p>
          <div class="work-editorial-slide__body">
            <h3 class="work-editorial-slide__title font-display">
              {t("work.film.title")}
            </h3>
            <div class="work-editorial-slide__copy">
              <p>{t("work.film.desc")}</p>
            </div>
          </div>
        </article>

        <article
          class="work-carousel__slide work-editorial-slide"
          data-work-slide
        >
          <p class="work-editorial-slide__eyebrow font-mono">
            <!-- 04 / {t("work.photography.kind")} -->
          </p>
          <div class="work-editorial-slide__body">
            <h3 class="work-editorial-slide__title font-display">
              {t("work.photography.title")}
            </h3>
            <div class="work-editorial-slide__copy">
              <p>{t("work.photography.desc")}</p>
              <a href="#gallery" class="work-editorial-slide__link font-mono">
                {t("work.photography.link")}
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>

</section>

<section id="gallery" class="flex min-h-[100svh] w-full scroll-mt-24 flex-col justify-center border-t border-line">
  <CarouselComponent
      photos={photos}
      galleryLabel={t("gallery.title")}
      pauseLabel={t("gallery.pause")}
      playLabel={t("gallery.play")}
      emptyLabel={t("gallery.empty")}
      client:visible
    />
  </section>

<script>
  const projectCarousels = document.querySelectorAll<HTMLElement>(
    "[data-work-carousel]",
  );

  projectCarousels.forEach((carousel) => {
    const viewport = carousel.querySelector<HTMLElement>(
      "[data-work-viewport]",
    );
    const slides = Array.from(
      carousel.querySelectorAll<HTMLElement>("[data-work-slide]"),
    );
    const count = carousel.querySelector<HTMLElement>("[data-work-count]");
    const previous = carousel.querySelector<HTMLButtonElement>(
      "[data-work-previous]",
    );
    const next = carousel.querySelector<HTMLButtonElement>("[data-work-next]");
    if (!viewport || slides.length === 0 || !count || !previous || !next)
      return;

    let activeIndex = 0;
    let updateFrame = 0;

    const updateControls = () => {
      const viewportLeft = viewport.getBoundingClientRect().left;
      activeIndex = slides.reduce((closestIndex, slide, index) => {
        const currentDistance = Math.abs(
          slide.getBoundingClientRect().left - viewportLeft,
        );
        const closestDistance = Math.abs(
          slides[closestIndex].getBoundingClientRect().left - viewportLeft,
        );
        return currentDistance < closestDistance ? index : closestIndex;
      }, 0);

      count.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
      previous.disabled = activeIndex === 0;
      next.disabled = activeIndex === slides.length - 1;
    };

    const goTo = (index: number) => {
      const targetIndex = Math.max(0, Math.min(index, slides.length - 1));
      viewport.scrollTo({
        left: slides[targetIndex].offsetLeft,
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "auto"
          : "smooth",
      });
    };

    previous.addEventListener("click", () => goTo(activeIndex - 1));
    next.addEventListener("click", () => goTo(activeIndex + 1));

    viewport.addEventListener(
      "scroll",
      () => {
        if (updateFrame) return;
        updateFrame = window.requestAnimationFrame(() => {
          updateControls();
          updateFrame = 0;
        });
      },
      { passive: true },
    );

    viewport.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        goTo(activeIndex - 1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        goTo(activeIndex + 1);
      }
    });

    updateControls();
  });
</script>
