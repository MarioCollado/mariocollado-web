---
import { getGitHubRepos, formatRepoDate } from "@/lib/github";

const repos = await getGitHubRepos("MarioCollado", 6);
---

<section
  id="tech"
  class="h-screen flex flex-col justify-between py-8 bg-primary-light text-gray-800 relative overflow-hidden snap-start"
>
  <div
    class="w-full px-4 py-4 md:px-8 max-w-5xl mx-auto flex-1 flex flex-col relative z-10"
  >
    <div class="text-center mb-4 md:mb-6">
      <div class="inline-flex items-center gap-3 mb-4">
        <h1
          class="text-2xl md:text-3xl font-bold font-druk text-secondary-blue tracking-wide"
        >
          TECH
        </h1>
      </div>
      <p class="text-sm md:text-base text-gray-600 font-light">
        Algunos de mis proyectos
      </p>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-6 flex-1 overflow-y-auto p-8"
    >
      {
        repos.map((repo) => (
          <div class="group relative h-full min-h-[200px]">
            <a
              href={repo.html_url}
              target="_blank"
              rel="noopener noreferrer"
              class="block h-full p-6 rounded-xl bg-white/95 border border-white/40 shadow-lg hover:shadow-2xl hover:border-secondary-purple/30 transition-all duration-300 hover:scale-[1.02] hover:-translate-y-1 relative overflow-hidden"
            >
              <div class="absolute inset-0 bg-gradient-to-br from-secondary-blue/5 to-secondary-purple/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl" />
              <div class="absolute -top-2 -right-2 w-16 h-16 bg-gradient-to-br from-secondary-blue/15 to-secondary-purple/15 rounded-full blur-xl opacity-0 group-hover:opacity-100 transition-all duration-500 group-hover:scale-150" />
              <div class="absolute -bottom-2 -left-2 w-12 h-12 bg-gradient-to-br from-secondary-green/15 to-secondary-orange/15 rounded-full blur-lg opacity-0 group-hover:opacity-100 transition-all duration-500" />

              <div class="relative z-10 h-full flex flex-col">
                <div class="flex items-start justify-between mb-3">
                  <h3 class="font-bold text-xl mb-1 text-gray-800 group-hover:text-secondary-blue transition-colors duration-300 truncate">
                    {repo.name}
                  </h3>
                  <div class="ml-3 p-2 rounded-lg bg-gray-100 group-hover:bg-secondary-blue/20 transition-all duration-300">
                    <svg
                      class="w-5 h-5 text-gray-600 group-hover:text-secondary-blue transition-colors duration-300"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </div>
                </div>

                <p class="text-gray-600 text-sm mb-4 line-clamp-2 flex-grow leading-relaxed">
                  {repo.description || "Proyecto sin descripción disponible"}
                </p>

                {repo.language && (
                  <div class="mb-4">
                    <span class="bg-gray-800 group-hover:bg-secondary-blue text-white px-3 py-1.5 text-xs font-medium rounded-full transition-all duration-300">
                      {repo.language}
                    </span>
                  </div>
                )}

                <div class="flex justify-between items-center pt-3 border-t border-gray-200/60">
                  <div class="flex items-center space-x-4 text-xs text-gray-500">
                    <span class="flex items-center space-x-1">
                      <span class="text-yellow-500">⭐</span>
                      <span class="font-medium">{repo.stargazers_count}</span>
                    </span>
                    <span class="flex items-center space-x-1">
                      <span class="text-secondary-green">🍴</span>
                      <span class="font-medium">{repo.forks_count}</span>
                    </span>
                  </div>
                  <span class="flex items-center space-x-1 text-xs text-gray-500">
                    <span class="text-green-500">📅</span>
                    <span class="font-medium">
                      {formatRepoDate(repo.updated_at)}
                    </span>
                  </span>
                </div>

                <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0 transition-all duration-300">
                  <svg
                    class="w-5 h-5 text-secondary-blue"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    />
                  </svg>
                </div>
              </div>
            </a>
          </div>
        ))
      }
    </div>

    <div class="text-center relative z-10">
      <a
        href="https://github.com/MarioCollado"
        target="_blank"
        class="inline-block bg-black text-white px-6 py-3 text-sm rounded-full border-2 border-black hover:bg-transparent hover:text-black transition-all duration-200 font-bold shadow-md hover:shadow-lg"
      >
        Ver Perfil GitHub
      </a>
    </div>
  </div>
</section>

<style>
  .overflow-y-auto::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  .overflow-y-auto::-webkit-scrollbar-track {
    background: var(--color-primary-light);
  }
  .overflow-y-auto::-webkit-scrollbar-thumb {
    background: var(--color-secondary-purple);
    border-radius: 3px;
  }
  .overflow-y-auto::-webkit-scrollbar-thumb:hover {
    background: var(--color-secondary-purple);
  }
  #tech {
    box-sizing: border-box;
  }
</style>
