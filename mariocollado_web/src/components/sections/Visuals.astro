---
import Carousel from "@/components/ui/Carousel.astro";
---

<section id="film" class="h-screen bg-primary-light snap-start relative">
  <!-- Contenedor principal -->
  <div class="h-full w-full">
    <!-- Contenido centrado -->
    <div
      class="relative z-10 container mx-auto px-4 md:px-8 min-h-full flex flex-col"
    >
      <!-- Cabecera -->
      <div class="flex flex-col items-center text-center py-8">
        <h2
          class="text-3xl md:text-4xl font-bold font-druk text-transparent bg-clip-text bg-gradient-to-r from-secondary-pink to-secondary-cyan"
        >
          VISUALS
        </h2>
        <p class="text-base md:text-lg text-gray-600 max-w-md mt-2">
          Mi colección fotográfica y videográfica
        </p>
      </div>

      <!-- Carrusel -->
      <div class="flex-1 pb-8">
        <Carousel />
      </div>
    </div>
  </div>
</section>
