---
import Carousel from "@/components/ui/Carousel.astro";
---

<section id="film" class="h-screen bg-primary-light snap-start relative">
  <div class="h-full w-full relative">
    <div
      class="absolute inset-0 bg-gradient-to-br from-red-50/20 to-orange-50/20"
    >
    </div>

    <div
      class="relative z-10 container mx-auto px-4 md:px-8 min-h-full flex flex-col"
    >
      <div class="flex flex-col items-center text-center py-12">
        <div class="inline-flex items-center gap-3 mb-6">
          <h2
            class="text-2xl md:text-3xl font-bold font-druk text-secondary-blue tracking-wide"
          >
            VISUALS
          </h2>
        </div>
        <p class="text-sm md:text-base text-gray-600 max-w-md font-light">
          Mi colección fotográfica y videográfica
        </p>
      </div>

      <div class="flex-1 pb-12">
        <Carousel />
      </div>
    </div>
  </div>
</section>
