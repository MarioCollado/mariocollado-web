---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
const items = [
  { key: "technology" },
  { key: "visuals" },
  { key: "music" },
];
---

<div id="disciplines" class="mt-16 scroll-mt-24">
  <h2 class="mb-10 font-mono text-xs uppercase tracking-widest text-muted">{t("disciplines.title")}</h2>
  <ol class="mx-auto w-[88%] border-y border-dashed border-line">
    {
      items.map((item, index) => (
        <li class="grid gap-4 border-t border-dashed border-line py-8 first:border-t-0 md:grid-cols-12">
          <span class="font-mono text-sm text-muted md:col-span-1">{String(index + 1).padStart(2, "0")}</span>
          <h3 class="font-display text-3xl font-semibold tracking-tight md:col-span-4">
            {t(`disciplines.${item.key}.title`)}
          </h3>
          <p class="text-lg leading-relaxed md:col-span-6">{t(`disciplines.${item.key}.desc`)}</p>
        </li>
      ))
    }
  </ol>
</div>
