---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="contact"
  class="min-h-screen flex flex-col justify-center items-center bg-primary-light text-gray-800 relative snap-start py-8 md:py-12 overflow-hidden"
>
  <div class="relative z-10 w-full max-w-md px-4">
    <div
      class="bg-white/80 backdrop-blur-lg p-6 md:p-8 rounded-2xl shadow-xl border border-white/30 hover:shadow-2xl transition-all duration-300"
    >
      <div class="text-center mb-6">
        <div class="inline-flex items-center gap-3 mb-4">
          <h1
            class="text-2xl md:text-3xl font-bold font-druk text-secondary-blue tracking-wide"
          >
            {t("contact.title")}
          </h1>
        </div>
        <p class="text-sm md:text-base text-gray-600 font-light">
          {t("contact.subtitle")}
        </p>
      </div>

      <div
        id="statusMessage"
        class="hidden mb-4 p-3 rounded-lg text-center font-medium"
      >
      </div>

      <form id="contactForm" class="space-y-5">
        <div class="group">
          <label class="block font-semibold text-gray-700 mb-2"
            >{t("contact.name")}</label
          >
          <input
            id="userName"
            name="userName"
            type="text"
            class="w-full p-3 bg-white/90 border-2 border-gray-200 rounded-xl focus:border-secondary-blue focus:bg-white focus:shadow-lg focus:shadow-secondary-blue/20 transition-all duration-300 placeholder-gray-400"
            placeholder={t("contact.name_placeholder")}
            required
          />
        </div>

        <div class="group">
          <label class="block font-semibold text-gray-700 mb-2"
            >{t("contact.email")}</label
          >
          <input
            id="userEmail"
            name="userEmail"
            type="email"
            class="w-full p-3 bg-white/90 border-2 border-gray-200 rounded-xl focus:border-secondary-blue focus:bg-white focus:shadow-lg focus:shadow-secondary-blue/20 transition-all duration-300 placeholder-gray-400"
            placeholder={t("contact.email_placeholder")}
            required
          />
        </div>

        <div class="group">
          <label class="block font-semibold text-gray-700 mb-2"
            >{t("contact.message")}</label
          >
          <textarea
            id="message"
            name="message"
            rows="4"
            class="w-full p-3 bg-white/90 border-2 border-gray-200 rounded-xl focus:border-secondary-blue focus:bg-white focus:shadow-lg focus:shadow-secondary-blue/20 transition-all duration-300 placeholder-gray-400 resize-none"
            placeholder={t("contact.message_placeholder")}
            required></textarea>
        </div>

        <button
          id="submitButton"
          type="submit"
          class="w-full bg-gradient-to-r from-secondary-blue to-secondary-blue-light text-white px-6 py-3 rounded-xl font-bold hover:shadow-xl hover:shadow-secondary-blue/30 hover:scale-[1.02] transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none"
        >
          <span id="buttonText">{t("contact.send")}</span>
        </button>
      </form>
    </div>
  </div>
</section>

<script
  define:vars={{
    translations: {
      send: t("contact.send"),
      sending: t("contact.sending"),
      success: t("contact.success"),
      errorEmptyFields: t("contact.error_empty_fields"),
      errorInvalidEmail: t("contact.error_invalid_email"),
      errorConnection: t("contact.error_connection"),
      errorUnknown: t("contact.error_unknown"),
    },
  }}
>
  const API_ENDPOINT = `${window.location.origin}/api/save-message`;

  document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("contactForm");
    const submitButton = document.getElementById("submitButton");
    const buttonText = document.getElementById("buttonText");
    const statusMessage = document.getElementById("statusMessage");

    function showStatus(message, type) {
      statusMessage.textContent = message;
      statusMessage.className = `mb-4 p-3 rounded border-2 border-black text-center font-bold ${
        type === "success"
          ? "bg-green-100 text-green-800"
          : type === "error"
            ? "bg-red-100 text-red-800"
            : "bg-blue-100 text-blue-800"
      }`;
      statusMessage.classList.remove("hidden");
    }

    function hideStatus() {
      statusMessage.classList.add("hidden");
    }

    function setButtonState(loading) {
      if (loading) {
        submitButton.disabled = true;
        buttonText.textContent = translations.sending;
      } else {
        submitButton.disabled = false;
        buttonText.textContent = translations.send;
      }
    }

    function clearForm() {
      form.reset();
    }

    form.addEventListener("submit", async function (e) {
      e.preventDefault();

      const formData = new FormData(form);
      const data = {
        userName: formData.get("userName")
          ? String(formData.get("userName"))
          : "",
        userEmail: formData.get("userEmail")
          ? String(formData.get("userEmail"))
          : "",
        message: formData.get("message") ? String(formData.get("message")) : "",
      };

      if (
        !data.userName.trim() ||
        !data.userEmail.trim() ||
        !data.message.trim()
      ) {
        showStatus(translations.errorEmptyFields, "error");
        return;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(data.userEmail)) {
        showStatus(translations.errorInvalidEmail, "error");
        return;
      }

      try {
        setButtonState(true);
        showStatus("Enviando mensaje...", "loading");

        const response = await fetch(API_ENDPOINT, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          showStatus(translations.success, "success");
          clearForm();
          setTimeout(() => hideStatus(), 5000);
        } else {
          throw new Error(result.error || translations.errorUnknown);
        }
      } catch (error) {
        console.error("Error:", error);
        showStatus(
          error instanceof Error && error.message.includes("fetch")
            ? translations.errorConnection
            : `Error: ${error instanceof Error ? error.message : translations.errorUnknown}`,
          "error"
        );
      } finally {
        setButtonState(false);
      }
    });

    const inputs = form.querySelectorAll("input, textarea");
    inputs.forEach((input) => {
      input.addEventListener("input", () => {
        if (
          !statusMessage.classList.contains("hidden") &&
          statusMessage.textContent?.includes("Error")
        ) {
          hideStatus();
        }
      });
    });
  });
</script>

<style>
  #submitButton:disabled #buttonText::after {
    content: "";
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-left: 8px;
    border: 2px solid transparent;
    border-top: 2px solid currentColor;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  #statusMessage {
    transition: all 0.3s ease-in-out;
  }

  #statusMessage.hidden {
    opacity: 0;
    transform: translateY(-10px);
  }
</style>
