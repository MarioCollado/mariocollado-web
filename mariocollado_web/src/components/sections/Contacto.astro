---
import socialLinks from "@/json/social.json";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="contact"
  class="min-h-screen flex flex-col justify-center items-center bg-primary-light text-gray-800 relative snap-start py-8 md:py-12 overflow-hidden"
>
  <div class="relative z-10 w-full max-w-md px-4 text-center">
    <h1 class="text-2xl md:text-3xl font-bold font-druk text-secondary-blue tracking-wide mb-2">
      {t("contact.title")}
    </h1>
    <p class="text-sm md:text-base text-gray-600 font-light mb-8">
      {t("contact.subtitle")}
    </p>
    <ul class="flex justify-center gap-6">
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={`https://${link.url}`}
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-4"
            >
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
