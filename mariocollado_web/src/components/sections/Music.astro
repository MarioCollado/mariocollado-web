---
import PlaylistCard from "@/components/ui/PlaylistCard.astro";
---

<section
  id="music"
  class="min-h-screen flex flex-col justify-center items-center bg-primary-light text-gray-800 relative snap-start py-8 md:py-12 overflow-hidden"
>
  <div class="flex-1 flex flex-col items-center justify-center py-12 relative">
    <div
      class="absolute inset-0 bg-gradient-to-br from-red-50/20 to-orange-50/20"
    >
    </div>

    <div class="text-center mb-12 px-4 relative z-10">
      <div class="inline-flex items-center gap-3 mb-6">
        <div
          class="w-1 h-8 bg-gradient-to-b from-secondary-blue to-secondary-blue-light rounded-full"
        >
        </div>
        <h2
          class="text-2xl md:text-3xl font-bold font-druk text-secondary-blue tracking-wide"
        >
          MÚSICA
        </h2>
        <div
          class="w-1 h-8 bg-gradient-to-b from-secondary-blue to-secondary-blue-light rounded-full"
        >
        </div>
      </div>
      <p class="text-sm md:text-base text-gray-600 max-w-md mx-auto font-light">
        Descubre mis playlists y publicaciones musicales
      </p>
    </div>

    <div class="w-full max-w-6xl px-4 relative z-10">
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 justify-items-center"
      >
        <div class="group w-full max-w-md">
          <div
            class="backdrop-blur-lg rounded-2xl p-6 shadow-lg hover:shadow-xl border border-white/30 hover:border-secondary-blue/30 transition-all duration-500 hover:scale-105 hover:-translate-y-2"
          >
            <div class="flex items-center mb-4">
              <div class="w-2 h-8 bg-secondary-blue rounded-full mr-3"></div>
              <h3
                class="font-bold text-lg text-gray-800 group-hover:text-secondary-blue transition-colors"
              >
                Todo lo que escucho
              </h3>
            </div>
            <div class="rounded-xl overflow-hidden shadow-md">
              <iframe
                style="border-radius:12px"
                src="https://open.spotify.com/embed/playlist/5ccbwKAM3fMNbG82oq89dX?utm_source=generator"
                width="100%"
                height="352"
                frameborder="0"
                allowfullscreen=""
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                loading="lazy"></iframe>
            </div>
          </div>
        </div>

        <div class="group w-full max-w-md">
          <div
            class="backdrop-blur-lg rounded-2xl p-6 shadow-lg hover:shadow-xl border border-white/30 hover:border-secondary-blue/30 transition-all duration-500 hover:scale-105 hover:-translate-y-2"
          >
            <div class="flex items-center mb-4">
              <div class="w-2 h-8 bg-secondary-blue rounded-full mr-3"></div>
              <h3
                class="font-bold text-lg text-gray-800 group-hover:text-secondary-blue transition-colors"
              >
                Mi álbum "la renaissance"
              </h3>
            </div>
            <div class="rounded-xl overflow-hidden shadow-md">
              <iframe
                data-testid="embed-iframe"
                style="border-radius:12px"
                src="https://open.spotify.com/embed/album/7bqMbjBDH5YXqErJmON5nd?utm_source=generator"
                width="100%"
                height="352"
                frameborder="0"
                allowfullscreen=""
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                loading="lazy"></iframe>
            </div>
          </div>
        </div>

        <div class="group w-full max-w-md">
          <div
            class="backdrop-blur-lg rounded-2xl p-6 shadow-lg hover:shadow-xl border border-white/30 hover:border-secondary-blue/30 transition-all duration-500 hover:scale-105 hover:-translate-y-2"
          >
            <div class="flex items-center mb-4">
              <div class="w-2 h-8 bg-secondary-blue rounded-full mr-3"></div>
              <h3
                class="font-bold text-lg text-gray-800 group-hover:text-secondary-blue transition-colors"
              >
                Para trabajar
              </h3>
            </div>
            <div class="rounded-xl overflow-hidden shadow-md">
              <iframe
                style="border-radius:12px"
                src="https://open.spotify.com/embed/playlist/6nFATDq2kBuOpKh6mKABVz?utm_source=generator"
                width="100%"
                height="352"
                frameborder="0"
                allowfullscreen=""
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                loading="lazy"></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
