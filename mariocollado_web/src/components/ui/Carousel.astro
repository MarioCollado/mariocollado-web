---
import CarouselComponent from "../../lib/carousel";
import { getAllMedia } from "../../lib/supabase";

const media = await getAllMedia();
---

<section class="w-full">
  {
    media.length > 0 ? (
      <CarouselComponent media={media} client:load />
    ) : (
      <div class="flex flex-col items-center justify-center p-12 text-center">
        <div class="bg-white/95 backdrop-blur-lg rounded-2xl p-8 shadow-lg border border-white/40">
          <div class="w-16 h-16 bg-secondary-green/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg
              class="w-8 h-8 text-secondary-blue"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
          </div>
          <p class="text-gray-700 font-medium">
            No hay contenido disponible en este momento.
          </p>
          <p class="text-gray-400 text-sm mt-2">
            Pronto habrá nuevas fotos y videos
          </p>
        </div>
      </div>
    )
  }
</section>
