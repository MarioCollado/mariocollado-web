---
import socialLinks from "@/json/social.json";
import { supabase } from "@/lib/supabase";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const SECTIONS_PATH = "sections/iconBW.png";
let bgUrl = supabase.storage.from("media").getPublicUrl(SECTIONS_PATH)
  .data.publicUrl;
try {
  const { data, error } = await supabase.storage
    .from("media")
    .createSignedUrl(SECTIONS_PATH, 60 * 60);
  if (!error && data?.signedUrl) bgUrl = data.signedUrl;
} catch {}
---

<div
  class="group relative rounded-xl overflow-hidden flex flex-col justify-center items-center text-center p-3 sm:p-4 lg:p-8 shadow-lg hover:shadow-xl transition-shadow duration-300 h-full w-full"
  style={`background: url('${bgUrl}') center/cover;`}
>
  <a href="#contact" class="absolute inset-0"></a>
  <div
    class="absolute inset-0 bg-black/30 group-hover:bg-black/50 transition-colors duration-300"
  >
  </div>
  <div class="relative z-10 flex items-center justify-center h-full">
    <div class="flex gap-2 sm:gap-3 lg:gap-4 justify-center">
      {
        socialLinks.map((link) => (
          <a
            href={`https://${link.url}`}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:scale-110 transition-transform"
            aria-label={t("profile.social_label", { platform: link.name })}
            title={link.name}
          >
            <img
              src={`/icon-profile/icons8-${link.name}.svg`}
              alt={link.name}
              class="w-4 h-4 sm:w-5 sm:h-5 lg:w-6 lg:h-6"
              loading="lazy"
              width="24"
              height="24"
            />
          </a>
        ))
      }
    </div>
  </div>
</div>
