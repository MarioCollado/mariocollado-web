---
import { getLangFromUrl, useTranslations, languages, translatePath } from "@/i18n/utils";
import type { SupportedLanguage } from "@/i18n/types";

interface Props {
  layer: "base" | "top";
}
const { layer } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isTop = layer === "top";
---

<div class={`bar bar--${layer}`} aria-hidden={isTop ? "true" : undefined} inert={isTop}>
  <div class="mx-auto flex h-20 max-w-[1440px] items-center justify-between gap-6 px-4 md:px-10">
    <a href={translatePath("/", lang)} class="font-display text-xl font-semibold tracking-tight">mariocollado.</a>

    <nav aria-label="Principal" class="hidden gap-8 font-mono text-sm tracking-wide md:flex">
      <a href="#work" class="hover:underline underline-offset-4">WORK</a>
      <a href="#about" class="hover:underline underline-offset-4">ABOUT</a>
      <a href="#contact" class="hover:underline underline-offset-4">CONTACT</a>
    </nav>

    <div class="flex items-center gap-4">
      <nav aria-label={t("nav.languages")} class="flex gap-3 font-mono text-xs uppercase">
        {
          Object.keys(languages).map((code) => (
            <a
              href={translatePath("/", code as SupportedLanguage)}
              hreflang={code}
              aria-current={code === lang ? "page" : undefined}
              class={code === lang ? "underline underline-offset-4" : "opacity-60 hover:opacity-100"}
            >
              {code}
            </a>
          ))
        }
      </nav>
      <button
        type="button"
        id={isTop ? undefined : "theme-toggle"}
        class="rounded-full border border-current px-3 py-1.5 font-mono text-xs uppercase"
        aria-label={t("nav.theme")}
      >
        {t("nav.theme")}
      </button>
    </div>
  </div>
</div>
