---
import { getLangFromUrl, useTranslations, languages, translatePath } from "@/i18n/utils";
import type { SupportedLanguage } from "@/i18n/types";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const navItems = [
  { href: "#work", label: "WORK" },
  { href: "#contact", label: "CONTACT" },
  { href: "#about", label: "ABOUT" },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-40 h-12 bg-bg">
  <!-- Capa base: texto en tinta sobre el papel -->
  <div class="layer layer--base">
    <a href={translatePath("/", lang)} class="col col--brand font-display text-base font-semibold tracking-tight">mariocollado.</a>
    <nav aria-label="Principal" class="contents max-md:hidden">
      {navItems.map((item) => (
        <a href={item.href} class="col font-mono text-xs tracking-wide">{item.label}</a>
      ))}
    </nav>
    <div class="col col--tools font-mono text-[11px] uppercase">
      <nav aria-label={t("nav.languages")} class="flex gap-3">
        {Object.keys(languages).map((code) => (
          <a
            href={translatePath("/", code as SupportedLanguage)}
            hreflang={code}
            aria-current={code === lang ? "page" : undefined}
            class={code === lang ? "underline underline-offset-4" : "opacity-60 hover:opacity-100"}
          >{code}</a>
        ))}
      </nav>
      <button type="button" id="theme-toggle" class="rounded-full border border-current px-3 py-1.5" aria-label={t("nav.theme")}>{t("nav.theme")}</button>
    </div>
  </div>

  <!-- Capa superior: relleno en tinta que avanza con el scroll -->
  <div class="layer layer--top" aria-hidden="true" inert>
    <span class="col col--brand font-display text-base font-semibold tracking-tight">mariocollado.</span>
    <span class="contents max-md:hidden">
      {navItems.map((item) => (
        <span class="col font-mono text-xs tracking-wide">{item.label}</span>
      ))}
    </span>
    <span class="col col--tools font-mono text-xs uppercase">&nbsp;</span>
  </div>
</header>

<style>
  .layer {
    position: absolute;
    inset: 0;
    display: flex;
    gap: 6px;
  }
  .layer--base {
    --bar-fg: var(--fg);
  }
  .layer--top {
    --bar-bg: var(--fg);
    --bar-fg: var(--bg);
    pointer-events: none;
  }
  /* Cada columna es un paralelogramo con bordes diagonales */
  .col {
    position: relative;
    isolation: isolate;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-inline: 1rem;
    color: var(--bar-fg);
  }
  .col::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--bar-bg, transparent);
    clip-path: polygon(16px 0, 100% 0, calc(100% - 16px) 100%, 0 100%);
    transform-origin: left center;
    transform: scaleX(var(--fill, 0));
  }
  .layer--base .col::before {
    display: none;
  }
  .col--brand {
    flex: 0 0 auto;
    justify-content: flex-start;
    padding-inline: 1rem 2rem;
  }
  .col--tools {
    flex: 0 0 auto;
    padding-inline: 1.5rem 1rem;
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const cols = Array.from(header?.querySelectorAll<HTMLElement>(".layer--top .col") ?? []);

  // Progreso de la página (0 arriba, 1 al final). Cada columna se llena en orden.
  const update = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    const n = cols.length;
    cols.forEach((col, i) => {
      const fill = Math.min(1, Math.max(0, p * n - i));
      col.style.setProperty("--fill", fill.toFixed(3));
    });
  };

  let frame = 0;
  const schedule = () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(update);
  };
  window.addEventListener("scroll", schedule, { passive: true });
  window.addEventListener("resize", schedule);
  update();

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch (e) {}
  });
</script>
