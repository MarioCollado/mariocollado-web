---
import HeaderBar from "@/components/HeaderBar.astro";
---

<header id="site-header" class="fixed inset-x-0 top-0 z-40 h-20">
  <HeaderBar layer="base" />
  <HeaderBar layer="top" />
</header>

<style>
  .bar {
    position: absolute;
    inset: 0;
    background-color: var(--bar-bg, var(--fg));
    color: var(--bar-fg, var(--bg));
    border-bottom: 1px solid color-mix(in srgb, currentColor 25%, transparent);
  }
  /* La capa que se barre se extiende un 25% a cada lado; el padding mantiene el texto alineado */
  .bar--top {
    left: -25%;
    right: -25%;
    padding-inline: 25%;
    pointer-events: none;
    clip-path: polygon(10% 0%, 100% 0%, 90% 100%, 0% 100%);
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const base = header?.querySelector<HTMLElement>('[data-layer="base"]');
  const top = header?.querySelector<HTMLElement>('[data-layer="top"]');
  const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-tone]"));
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let current: string | null = null;

  const colors = (tone: string, el: HTMLElement) => {
    // La cabecera toma el color contrario de la sección que tiene debajo
    el.style.setProperty("--bar-bg", tone === "inverse" ? "var(--bg)" : "var(--fg)");
    el.style.setProperty("--bar-fg", tone === "inverse" ? "var(--fg)" : "var(--bg)");
  };

  const toneUnderHeader = () => {
    const y = (header?.offsetHeight ?? 80) / 2;
    let tone = "base";
    for (const s of sections) {
      const r = s.getBoundingClientRect();
      if (r.top <= y && r.bottom > y) tone = s.dataset.tone ?? "base";
    }
    return tone;
  };

  const update = () => {
    if (!base || !top) return;
    const tone = toneUnderHeader();
    if (tone === current) return;
    const first = current === null;
    current = tone;
    if (first || reduce) {
      colors(tone, base);
      colors(tone, top);
      return;
    }
    colors(tone, top);
    // Barrido diagonal desde la esquina superior izquierda
    // Barrido de izquierda a derecha con bordes inclinados (no paralelos a la ventana)
    top.animate(
      [
        { clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)" },
        { clipPath: "polygon(10% 0%, 100% 0%, 90% 100%, 0% 100%)" },
      ],
      { duration: 900, easing: "cubic-bezier(0.22, 1, 0.36, 1)" }
    ).onfinish = () => colors(tone, base!);
  };

  let frame = 0;
  const schedule = () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(update);
  };
  window.addEventListener("scroll", schedule, { passive: true });
  window.addEventListener("resize", schedule);
  update();

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch (e) {}
  });
</script>
