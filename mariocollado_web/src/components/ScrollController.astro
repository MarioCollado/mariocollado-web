---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
const sections = [
  { id: "hero", label: t("meta.title") },
  { id: "work", label: t("nav.work") },
  { id: "about", label: t("nav.about") },
  { id: "disciplines", label: t("disciplines.title") },
  { id: "contact", label: t("nav.contact") },
];
---

<nav aria-label="Secciones" class="fixed right-4 top-1/2 z-30 hidden -translate-y-1/2 flex-col items-end gap-3 md:flex">
  {sections.map((s) => (
    <a href={`#${s.id}`} data-progress data-id={s.id} data-active="false" aria-label={s.label} class="flex h-4 items-center">
      <span class="line h-px w-5 bg-line transition-all duration-300"></span>
    </a>
  ))}
</nav>

<script>
  import Lenis from "lenis";

  const SNAP_RANGE = 120; // px: solo engancha si estás cerca de una sección
  const HEADER = 56; // h-14
  const ids = ["hero", "work", "about", "disciplines", "contact"];
  const sections = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);
  const links = Array.from(document.querySelectorAll<HTMLElement>("[data-progress]"));
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  let lenis: Lenis | null = null;
  if (!reduce) {
    lenis = new Lenis({
      duration: 1.5,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothTouch: false,
      anchors: true,
    });
    const raf = (time: number) => {
      lenis!.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);

    // Enganche suave: cuando paras cerca de una sección, te colocas en ella
    let timer = 0;
    lenis.on("scroll", () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (!lenis || lenis.isScrolling) return;
        let best: HTMLElement | null = null;
        let bestDist = Infinity;
        for (const el of sections) {
          const dist = Math.abs(el.getBoundingClientRect().top - HEADER);
          if (dist < bestDist) {
            bestDist = dist;
            best = el;
          }
        }
        if (best && bestDist > 1 && bestDist <= SNAP_RANGE) {
          lenis.scrollTo(best, { offset: -HEADER, duration: 1 });
        }
      }, 200);
    });
  }

  // Indicador lateral: resalta la sección visible
  const update = () => {
    const mid = window.innerHeight * 0.4;
    let active = sections[0]?.id;
    for (const el of sections) {
      if (el.getBoundingClientRect().top <= mid) active = el.id;
    }
    for (const a of links) {
      a.dataset.active = String(a.dataset.id === active);
    }
  };
  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
  update();
</script>

<style>
  [data-active="true"] .line {
    width: 2.5rem;
    background-color: var(--fg);
  }
</style>
