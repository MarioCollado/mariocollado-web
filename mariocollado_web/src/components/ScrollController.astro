---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
const sections = [
  { id: "hero", label: t("meta.title") },
  { id: "work", label: t("nav.work") },
  { id: "about", label: t("nav.about") },
  { id: "disciplines", label: t("disciplines.title") },
  { id: "contact", label: t("nav.contact") },
];
const TICKS = 14;
const ticks = Array.from({ length: TICKS }, (_, i) => i);
---

<div aria-hidden="true" class="fixed right-4 top-1/2 z-30 hidden -translate-y-1/2 flex-col items-end gap-2.5 md:flex">
  {ticks.map((i) => (
    <span data-tick={i} data-on="false" class="tick h-0.5 w-4 bg-fg/30 transition-colors duration-300"></span>
  ))}
</div>

<script>
  import Lenis from "lenis";

  const SNAP_RANGE = 120; // px: solo engancha si estás cerca de una sección
  const HEADER = 56; // h-14
  const ids = ["hero", "work", "about", "disciplines", "contact"];
  const sections = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  let lenis: Lenis | null = null;
  if (!reduce) {
    lenis = new Lenis({
      duration: 1.5,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothTouch: false,
      anchors: true,
    });
    const raf = (time: number) => {
      lenis!.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);

    // Enganche suave: cuando paras cerca de una sección, te colocas en ella
    let timer = 0;
    lenis.on("scroll", () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (!lenis || lenis.isScrolling) return;
        let best: HTMLElement | null = null;
        let bestDist = Infinity;
        for (const el of sections) {
          const dist = Math.abs(el.getBoundingClientRect().top - HEADER);
          if (dist < bestDist) {
            bestDist = dist;
            best = el;
          }
        }
        if (best && bestDist > 1 && bestDist <= SNAP_RANGE) {
          lenis.scrollTo(best, { offset: -HEADER, duration: 1 });
        }
      }, 200);
    });
  }

  // Indicador lateral: las marcas se encienden según el progreso del scroll
  const ticks = Array.from(document.querySelectorAll<HTMLElement>("[data-tick]"));
  const update = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    const lit = Math.round(p * ticks.length);
    ticks.forEach((tick, i) => {
      tick.dataset.on = String(i < lit);
    });
  };
  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
  update();
</script>

<style>
  [data-on="true"] {
    background-color: var(--fg);
  }
</style>
