---
import { getGalleryContent } from "@/lib/media";
import MediaItem from "@/components/ui/MediaItem.astro";

const content = await getGalleryContent();
---

<div class="columns-2 md:columns-3 lg:columns-4 gap-4 px-4">
  {
    content.map((item) => (
      <div class="mb-4 break-inside-avoid relative group">
        <MediaItem item={item} />
      </div>
    ))
  }
</div>

<style>
  /* Asegurar que los videos mantengan relación de aspecto */
  video {
    aspect-ratio: attr(width) / attr(height);
  }

  /* Mejorar la legibilidad del texto en hover */
  .group:hover p {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }
</style>
