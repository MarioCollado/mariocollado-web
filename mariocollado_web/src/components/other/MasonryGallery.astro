---
// src/components/other/MasonryGallery.astro
import { supabase } from "@/lib/supabase";

const { data: rows } = await supabase
  .from("media_items")
  .select("path, tipo, descripcion, orden, created_at, published")
  .eq("published", true)
  .order("orden", { ascending: true })
  .order("created_at", { ascending: true });

interface MediaItem {
  tipo: string;
  ruta: string;
  descripcion: string;
}

// Intentar usar URLs firmadas (funciona con bucket privado). Si falla, usar URL pública.
const content: MediaItem[] = await (async () => {
  const list = rows ?? [];
  const signed = await Promise.all(
    list.map(async (r: any) => {
      try {
        const { data, error } = await supabase.storage
          .from("media")
          .createSignedUrl(r.path, 60 * 60); // 1 hora
        const ruta = error
          ? supabase.storage.from("media").getPublicUrl(r.path).data.publicUrl
          : data!.signedUrl;
        return {
          tipo: r.tipo,
          ruta,
          descripcion: r.descripcion ?? r.path,
        } as MediaItem;
      } catch {
        return {
          tipo: r.tipo,
          ruta: supabase.storage.from("media").getPublicUrl(r.path).data
            .publicUrl,
          descripcion: r.descripcion ?? r.path,
        } as MediaItem;
      }
    })
  );
  return signed;
})();
---

<div class="columns-2 md:columns-3 lg:columns-4 gap-4 px-4">
  {
    content.map((item) => (
      <div class="mb-4 break-inside-avoid relative group">
        {item.tipo === "foto" ? (
          <div class="relative overflow-hidden rounded-lg shadow-sm hover:shadow-md transition-all duration-300">
            <img
              src={item.ruta}
              alt={item.descripcion}
              class="w-full h-auto transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
              <p class="text-white text-sm font-medium translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                {item.descripcion}
              </p>
            </div>
          </div>
        ) : (
          <div class="relative overflow-hidden rounded-lg shadow-sm hover:shadow-md transition-all duration-300">
            <video
              src={item.ruta}
              autoplay
              muted
              loop
              playsinline
              class="w-full h-auto transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
              <p class="text-white text-sm font-medium translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                {item.descripcion}
              </p>
            </div>
          </div>
        )}
      </div>
    ))
  }
</div>

<style>
  /* Asegurar que los videos mantengan relación de aspecto */
  video {
    aspect-ratio: attr(width) / attr(height);
  }

  /* Mejorar la legibilidad del texto en hover */
  .group:hover p {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }
</style>
